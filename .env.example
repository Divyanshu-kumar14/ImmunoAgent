# ============================================================================
# ImmunoAgent — environment template (Phase 0)
# ----------------------------------------------------------------------------
# 1. Copy this file to `.env`:   cp .env.example .env
# 2. Fill in your Gemini API key.
# 3. NEVER commit `.env` — it is gitignored and holds secrets.
# Key names map 1:1 to `backend/app/config.py` (Settings fields).
# ============================================================================

# --- Database (default: Postgres + pgvector) ---
# Used by the SQLAlchemy async engine; the `vector` extension + `uuid-ossp`
# are bootstrapped automatically on startup (database/connection.py).
DATABASE_URL=postgresql://immunoagent:secret@localhost:5432/immunoagent

# --- Redis (fast-path store: DAG, edges, telemetry stream, JWT deny-list) ---
REDIS_URL=redis://localhost:6379/0

# --- Gemini (LLM for async Sentinel analysis ONLY) ---
# Empty key => rule-based/mock fallback; the demo never hard-depends on the
# LLM. The security fast path (< 25 ms P95) is rule-based and never calls this.
GEMINI_API_KEY=your-gemini-api-key-here

# --- JWT signing (ephemeral agent tokens, HS256) ---
# Must be >= 32 bytes for HS256 (RFC 7518 §3.2). Dev default lives in
# config.py; set a real secret here in production and never commit it.
JWT_SECRET=dev-jwt-secret-change-me-in-prod-0123456789abcdef

# --- Application ---
APP_NAME=ImmunoAgent
DEBUG=True

# --- Ports (all configurable to avoid conflicts) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
